{
  "name": "edtech-exam-engine",
  "version": "1.0.0",
  "private": true,
  "description": "Bilingual competitive-exam engine (SSC, Banking, WBPSC, WB Postal) — practice + dynamic mock test APIs",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --env-file=test/test.env --test --test-concurrency=1 test/*.test.js",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.js",
    "admin:seed": "node --env-file-if-exists=.env scripts/seedAdmin.js",
    "db:indexes": "node --env-file-if-exists=.env -e \"require('node:child_process').execFileSync('mongosh',[process.env.MONGODB_URI,'db/indexes.mongo.js'],{stdio:'inherit'})\"",
    "db:duplicate-keys": "node --env-file-if-exists=.env scripts/backfillQuestionDuplicateKeys.js",
    "db:question-provenance": "node --env-file-if-exists=.env scripts/backfillQuestionProvenance.js",
    "db:seed-vocabulary": "node --env-file-if-exists=.env scripts/seedVocabularyStarter.js",
    "db:generate": "node --env-file-if-exists=.env scripts/generateAndSeed.js",
    "db:check-mobile-index": "node --env-file-if-exists=.env scripts/ensureMobileIndex.js",
    "db:hard-banks": "node --env-file-if-exists=.env scripts/seedHardBanks.js",
    "vocab:check": "node scripts/vocabulary/checkLexicon.mjs",
    "db:vocabulary-bank": "node --env-file-if-exists=.env scripts/seedVocabularyBank.js"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "mongoose": "^9.11.2",
    "multer": "^2.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "cmu-pronouncing-dictionary": "3.0.0",
    "katex": "^0.19.0",
    "mongodb-memory-server": "^11.3.0",
    "wordnet-db": "3.1.14"
  }
}
