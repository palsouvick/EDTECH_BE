NODE_ENV=production
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/edtech
# Number of proxies (LB/CDN) in front of the app, for correct client IPs.
TRUST_PROXY_HOPS=1

MOCK_SUBMIT_GRACE_SEC=60
MOCK_PAUSABLE_TTL_HOURS=72
MOCK_RECENT_EXCLUDE=5

STATS_FLUSH_MS=5000
STATS_MAX_BUFFER=2000
STATS_MIN_ATTEMPTS=30

# Signs login sessions: a long random string, required in production.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
AUTH_SESSION_DAYS=30

# On startup the server builds indexes, syncs the exam catalogue, inserts missing
# concept sheets / sample questions and, while none exist, generates the question
# bank in the background (src/db/bootstrap.js). Idempotent; no manual seeding needed.
AUTO_SEED=true
# Every chapter is topped up to this many generated questions (again whenever the
# target or the question files change). 0 = do not generate.
SEED_QUESTIONS_PER_TOPIC=300
